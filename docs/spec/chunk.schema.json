{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alien Skies encounter chunk, draft v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "biome",
    "durationSeconds",
    "threatCost",
    "intensity",
    "entryTags",
    "exitPolicy",
    "incompatibleHazards",
    "allowedTransforms",
    "limits",
    "spawns",
    "recoverySeconds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "biome": {
      "enum": [
        "khepri",
        "nacre",
        "vesper"
      ]
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 15,
      "maximum": 25
    },
    "threatCost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24
    },
    "intensity": {
      "enum": [
        "recovery",
        "low",
        "medium",
        "high"
      ]
    },
    "entryTags": {
      "$ref": "#/$defs/tags"
    },
    "exitPolicy": {
      "enum": [
        "wait-until-clear",
        "validated-overlap"
      ]
    },
    "incompatibleHazards": {
      "$ref": "#/$defs/tags"
    },
    "allowedTransforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "mirror-x"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simultaneousEnemies",
        "hostileProjectiles"
      ],
      "properties": {
        "simultaneousEnemies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "hostileProjectiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      }
    },
    "spawns": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "$ref": "#/$defs/spawn"
      }
    },
    "recoverySeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atSeconds",
        "enemyId",
        "x",
        "s",
        "patternId",
        "rewardEligible"
      ],
      "properties": {
        "atSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 25
        },
        "enemyId": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number",
          "minimum": -18,
          "maximum": 18
        },
        "s": {
          "type": "number",
          "minimum": 1,
          "maximum": 24
        },
        "patternId": {
          "type": "string",
          "minLength": 1
        },
        "rewardEligible": {
          "type": "boolean"
        }
      }
    }
  }
}
